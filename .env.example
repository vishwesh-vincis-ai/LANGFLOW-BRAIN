# Copy to .env and fill in. .env is gitignored; never commit a real key.
# In a Claude cloud session, prefer setting these as environment variables in the
# environment settings instead: they override this file and survive container resets.

# NVIDIA NIM (https://build.nvidia.com) — used for chat + embeddings when set
NVIDIA_API_KEY=

# Optional alternatives
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# LLM_PROVIDER=nvidia          # nvidia | gemini | claude | none
# EMBED_PROVIDER=nvidia        # nvidia | gemini | none
# NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brain
